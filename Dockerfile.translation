FROM python:3.10-slim

WORKDIR /app

RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

COPY translation-requirements.txt .
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch \
    && pip install --no-cache-dir -r translation-requirements.txt

COPY api/services/translation_server.py api/services/

ENV TRANSLATION_HOST=0.0.0.0

EXPOSE 8001

CMD ["python", "api/services/translation_server.py"]
